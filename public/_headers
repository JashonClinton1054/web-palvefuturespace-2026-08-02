/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self' https://ktxhpqztorfzxkyeixcf.supabase.co wss://ktxhpqztorfzxkyeixcf.supabase.co https://cloudflareinsights.com https://challenges.cloudflare.com; font-src 'self' data:; form-action 'self'; frame-ancestors 'self'; frame-src https://challenges.cloudflare.com; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests

/api/*
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/admin*
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/assets/*
  Cache-Control: public, max-age=31536000, immutable
